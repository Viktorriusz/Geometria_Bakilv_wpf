<Window x:Class="Geometria_Bakilv_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometria_Bakilv_wpf"
        mc:Ignorable="d"
        Title="Geometria Számító" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bal oldali menü a formák kiválasztásához -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Margin="0,0,15,0">
            <StackPanel Margin="15">
                <TextBlock Text="Geometria" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                <RadioButton x:Name="RbCircle" Content="Kör" IsChecked="True" Height="40" FontSize="14" GroupName="Shapes" Checked="Shape_Checked"/>
                <RadioButton x:Name="RbRectangle" Content="Téglalap" Height="40" FontSize="14" GroupName="Shapes" Checked="Shape_Checked"/>
                <RadioButton x:Name="RbTriangle" Content="Háromszög" Height="40" FontSize="14" GroupName="Shapes" Checked="Shape_Checked"/>
            </StackPanel>
        </Border>

        <!-- Jobb oldali adatbeviteli és eredmény panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Adatok megadása" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Beviteli mezők alakzatok szerint -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">

                    <!-- Kör panel -->
                    <StackPanel x:Name="PanelCircle" Visibility="Visible">
                        <TextBlock Text="Sugár (r):" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtRadius" Padding="8" FontSize="14"/>
                    </StackPanel>

                    <!-- Téglalap panel -->
                    <StackPanel x:Name="PanelRectangle" Visibility="Collapsed">
                        <TextBlock Text="'a' oldal (hossz):" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtRectA" Padding="8" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="'b' oldal (szélesség):" Margin="0,5,0,5"/>
                        <TextBox x:Name="TxtRectB" Padding="8" FontSize="14"/>
                    </StackPanel>

                    <!-- Háromszög panel -->
                    <StackPanel x:Name="PanelTriangle" Visibility="Collapsed">
                        <TextBlock Text="'a' oldal:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTriA" Padding="8" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock Text="'b' oldal:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTriB" Padding="8" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock Text="'c' oldal:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTriC" Padding="8" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <!-- Kiszámítás gomb az eseménykezelővel -->
                <Button Grid.Row="2" Content="Kiszámítás" Height="40" Margin="0,15,0,15"
                        Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14"
                        Click="BtnCalculate_Click"/>

                <!-- Eredmény kijelző mező -->
                <Border Grid.Row="3" Background="#E8F4F9" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="15" HorizontalAlignment="Center">
                            <Run Text="Kerület: "/><Run x:Name="LblPerimeter" FontWeight="Bold" Text="0"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="15" HorizontalAlignment="Center">
                            <Run Text="Terület: "/><Run x:Name="LblArea" FontWeight="Bold" Text="0"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>